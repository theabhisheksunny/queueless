{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "queueless",
  "main": "frontend/worker.ts",
  "compatibility_date": "2026-03-01",
  "build": {
    "command": "npm install && npm run build",
    "cwd": "frontend"
  },
  "assets": {
    "directory": "./frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "html_handling": "auto-trailing-slash"
  },
  "vars": {
    "BACKEND_API_URL": "https://queueless-backend-1043223278240.asia-south1.run.app"
  },
  "env": {
    "staging": {
      "name": "queueless-staging",
      "vars": {
        "BACKEND_API_URL": "https://queueless-backend-staging-1043223278240.asia-south1.run.app"
      }
    }
  },
  "observability": {
    "enabled": true
  }
}
