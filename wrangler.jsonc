{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "queueless",
  "main": "frontend/worker.ts",
  "compatibility_date": "2026-03-01",
  "build": {
    "command": "npm install && npm run build",
    "cwd": "frontend"
  },
  "assets": {
    "directory": "./frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "html_handling": "auto-trailing-slash"
  },
  // BACKEND_API_URL is managed exclusively via dynamic deployment workflows
  // (deploy/scripts/switch_edge_traffic.py) using `wrangler deploy --var BACKEND_API_URL:<target_url> --keep-vars`.
  // Static variables are omitted from this configuration to prevent frontend asset deployments
  // from silently overwriting active backend routing.
  "env": {
    "staging": {
      "name": "queueless-staging"
    }
  },
  "observability": {
    "enabled": true
  }
}
